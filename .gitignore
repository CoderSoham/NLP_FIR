# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
*.log

# Virtual environments
.venv/
venv/
ENV/

# OS/IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Environment/config
# Secrets. `.env.*` also matches `.env.example`, which must stay trackable --
# it is the documentation of what goes in `.env` and carries no values.
.env
.env.*
!.env.example
*.local

# Build/dist
build/
dist/
*.whl

# Models, datasets and anything derived from real calls.
# Ignored wholesale rather than by extension -- an extension list is a guess
# about which files are sensitive, and it guesses wrong.
models/

# App generated media and outputs
storage/
# Cached transcripts are derived from call audio and carry the same PII.
storage/transcripts/
uploads/
static/uploads/
processed/
static/plots/*.png
plots/
*.mp3
*.wav
*.m4a
*.ogg
*.flac
*.png
*.jpg
*.jpeg
*.pdf

# Machine-specific cache redirection (paths differ per machine).
.venvrc

# Temp files
*.tmp
*.temp
~$*
*.bak

# Notebooks checkpoints
.ipynb_checkpoints/

# Test artefacts
.pytest_cache/
