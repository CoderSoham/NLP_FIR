# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it
# must never contain a real value.
#
#     cp .env.example .env
#
# Real environment variables take precedence over this file.

# ---- LLM extraction backend -------------------------------------------------
# local | anthropic | nvidia | groq | openrouter | cerebras | mistral |
# ollama | llamacpp | none
LLM_BACKEND=local

# Hosted providers. Only the one matching LLM_BACKEND is needed.
# NOTE: a hosted provider receives the call transcript, which contains names,
# addresses and medical detail. Some free tiers train on submitted prompts.
NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=

# If the chosen provider is rate limited, try these next, in order. Unset means
# "any hosted provider whose key is present above". Set it to an empty value to
# turn failover off.
# LLM_FALLBACK_BACKENDS=groq,cerebras

# Override the provider's default model, or point at a different endpoint.
# LLM_MODEL=
# LLM_BASE_URL=

# ---- Local model ------------------------------------------------------------
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# LOCAL_LLM_DEVICE=cuda

# ---- Speech recognition -----------------------------------------------------
# FORCE_CPU=0
# WHISPER_MODEL_NAME=large-v3-turbo

# ---- Keep model weights off a small root partition --------------------------
# HF_HOME=/path/with/space/hf
# XDG_CACHE_HOME=/path/with/space/cache
