# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it
# must never contain a real value.
#
#     cp .env.example .env
#
# Real environment variables take precedence over this file.

# ---- LLM extraction backend -------------------------------------------------
# local | anthropic | nvidia | groq | openrouter | cerebras | mistral |
# ollama | llamacpp | none
LLM_BACKEND=local

# Hosted providers. Only the one matching LLM_BACKEND is needed.
# NOTE: a hosted provider receives the call transcript, which contains names,
# addresses and medical detail. Some free tiers train on submitted prompts.
NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=

# If the chosen provider is rate limited, try these next, in order. Unset means
# "any hosted provider whose key is present above". Set it to an empty value to
# turn failover off.
# LLM_FALLBACK_BACKENDS=groq,cerebras

# Override the provider's default model, or point at a different endpoint.
# LLM_MODEL=
# LLM_BASE_URL=

# Seconds for the whole extraction stage, retries included -- not per attempt.
# Since the local classifiers stopped running whenever extraction succeeds,
# this call is the request, so a hung provider holds an upload for the whole
# budget. When it expires the stage fails and the local path runs instead.
# LLM_DEADLINE=180

# ---- What the local models are for ------------------------------------------
# auto   (default) skip the BART classifier and summariser when the extraction
#        model returned a usable record. They are the fallback, not the
#        baseline: with no key, a failed call or an empty record, they run.
# always run them too, and show where the two paths disagree. Costs ~70s on a
#        ten-minute call and is the only way to get an independent check.
# never  never run them, even with no model.
# LOCAL_ANALYSIS=auto

# ---- Local model ------------------------------------------------------------
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# LOCAL_LLM_DEVICE=cuda

# ---- Dispatch ---------------------------------------------------------------
# The shipped stations.json is example data and labels itself as such in the
# UI and the report. Build a real one with scripts/build_stations.py.
# STATIONS_FILE=/path/to/stations.json
# DISPATCH_SPEED_KMH=50
#
# Geocoding the incident is off by default. A call's location is the most
# identifying string this pipeline produces; `nominatim` sends it to
# OpenStreetMap, `registry` uses the offline places table in your stations
# file and never touches the network.
# GEOCODER=off

# ---- Speech recognition -----------------------------------------------------
# FORCE_CPU=0
# WHISPER_MODEL_NAME=large-v3-turbo

# ---- Keep model weights off a small root partition --------------------------
# HF_HOME=/path/with/space/hf
# XDG_CACHE_HOME=/path/with/space/cache
